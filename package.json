{
  "name": "nexestra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @nexestra/server dev\" \"pnpm --filter @nexestra/web dev\"",
    "dev:server": "pnpm --filter @nexestra/server dev",
    "dev:web": "pnpm --filter @nexestra/web dev",
    "build": "pnpm --filter @nexestra/web build && pnpm --filter @nexestra/server build",
    "start": "pnpm --filter @nexestra/server start",
    "smoke": "pnpm --filter @nexestra/server smoke",
    "test": "pnpm -r --parallel test",
    "test:server": "pnpm --filter @nexestra/server test",
    "test:server:watch": "pnpm --filter @nexestra/server exec vitest",
    "test:web": "pnpm --filter @nexestra/web test",
    "test:web:watch": "pnpm --filter @nexestra/web exec vitest",
    "check:fast": "pnpm lint && concurrently -n types,test -c blue,green \"pnpm typecheck\" \"pnpm test\"",
    "check": "pnpm check:fast && pnpm build",
    "e2e": "pnpm build && pnpm --filter @nexestra/e2e e2e",
    "e2e:only": "pnpm --filter @nexestra/e2e e2e",
    "e2e:ui": "pnpm build && pnpm --filter @nexestra/e2e e2e:ui",
    "e2e:browsers": "pnpm --filter @nexestra/e2e browsers",
    "e2e:report": "pnpm --filter @nexestra/e2e e2e:report",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.1",
    "concurrently": "10.0.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
