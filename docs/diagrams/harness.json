          {
            "from": "active",
            "to": "in_review",
            "label": "Candidate artifact captured"
          },
          {
            "from": "in_review",
            "to": "passing",
            "label": "All required checks pass for frozen versions"
          },
          {
            "from": "in_review",
            "to": "active",
            "label": "Bounded actionable repair"
          },
          {
            "from": "active",
            "to": "blocked",
            "label": "Required decision or unavailable capability"
          },
          {
            "from": "blocked",
            "to": "active",
            "label": "Blocker resolved and authority retained"
          },
          {
            "from": "active",
            "to": "cancelled",
            "label": "Cancellation"
          },
          {
            "from": "in_review",
            "to": "cancelled",
            "label": "Cancellation"
          },
          {
            "from": "passing",
            "to": "not_started",
            "label": "Contract or accepted output changes"
          }
        ]
