      "title": "Implemented: shared work brief",
      "kind": "flowchart",
      "data": {
        "direction": "LR",
        "nodes": [
          {
            "id": "human",
            "label": "User: chat or Work Briefs"
          },
          {
            "id": "api",
            "label": "Scoped HTTP commands"
          },
          {
            "id": "store",
            "label": "FileStore: revision checks and fsync"
          },
          {
            "id": "journal",
            "label": "Canonical thread JSONL"
          },
          {
            "id": "dispatcher",
            "label": "Mention dispatcher"
          },
          {
            "id": "runtime",
            "label": "Codex / OpenCode / custom HTTP"
          },
          {
            "id": "tools",
            "label": "Master read_brief and draft_brief"
          }
        ],
        "edges": [
          {
            "from": "human",
            "to": "api",
            "label": "Read, save, confirm scope"
          },
          {
            "from": "api",
            "to": "store",
            "label": "Validated commands"
          },
          {
            "from": "store",
            "to": "journal",
            "label": "Append revisions"
          },
          {
            "from": "human",
            "to": "dispatcher",
            "label": "Explicit mention"
          },
          {
            "from": "store",
            "to": "dispatcher",
            "label": "Current brief"
          },
          {
            "from": "dispatcher",
            "to": "runtime",
            "label": "Pinned invocation context"
          },
          {
            "from": "runtime",
            "to": "tools",
            "label": "Custom Master only"
          },
          {
            "from": "tools",
            "to": "store",
            "label": "Same scoped commands"
          }
        ]
      }
    },
    {
