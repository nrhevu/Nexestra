    {
      "id": "target-lifecycle",
      "title": "Target: acceptance lifecycle, separate from run status",
      "kind": "state",
      "data": {
        "initial": "not_started",
        "states": [
          {
            "id": "not_started",
            "label": "Not started"
          },
          {
            "id": "active",
            "label": "Active"
          },
          {
            "id": "in_review",
            "label": "In review"
          },
          {
            "id": "blocked",
            "label": "Blocked"
          },
          {
            "id": "passing",
            "label": "Passing"
          },
          {
            "id": "cancelled",
            "label": "Cancelled"
          }
