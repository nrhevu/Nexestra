{
  "harness": "opencode",
  "harnessVersion": "1.18.25",
  "platform": "darwin arm64 (Darwin 27.0.0)",
  "node": "v24.19.0",
  "recordedAt": "2026-09-02",
  "scenario": "permission ask/reply cycle",
  "serverArgv": [
    "opencode",
    "serve",
    "--port",
    "4791",
    "--hostname",
    "127.0.0.1",
    "--print-logs",
    "--log-level",
    "INFO"
  ],
  "serverCwd": "/WORK/repo",
  "sessionCreateBody": {
    "title": "nexestra permission test",
    "permission": [
      {
        "permission": "bash",
        "pattern": "*",
        "action": "ask"
      }
    ]
  },
  "promptRequest": "POST /session/{id}/prompt_async -> 204 No Content",
  "pollRequest": "GET /permission -> [PermissionRequest]",
  "replyRequest": "POST /session/{id}/permissions/{permissionID} {response:'once'} -> true",
  "notes": "Global config here is permission {'*':'allow'}, so NO permission is asked by default. Per-session ruleset in the create body is what produces one."
}
